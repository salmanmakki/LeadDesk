# ──────────────────────────────────────────────
# Local Development (copy to .env and fill in)
# ──────────────────────────────────────────────

# Environment
NODE_ENV=development

# Server
PORT=5000

# Database (MongoDB Atlas connection string)
# ⚠️  Keep this secret. Never commit .env to version control.
MONGODB_URI=mongodb://localhost:27017/leaddesk-mini

# JWT
JWT_SECRET=change_this_to_a_random_secret_in_production
JWT_EXPIRES_IN=7d

# CORS origin (your frontend URL – local or deployed)
CLIENT_URL=http://localhost:5173

# Cookie
COOKIE_SECRET=change_this_to_a_cookie_secret

# Seed admin credentials (used by npm run seed)
# IMPORTANT: Set strong credentials here. The seed script will fail without them.
ADMIN_EMAIL=admin@leaddesk.com
ADMIN_PASSWORD=your_strong_password_here

# ──────────────────────────────────────────────
# Vercel Deployment
# ──────────────────────────────────────────────
# Set these environment variables in the Vercel Dashboard:
#
#   NODE_ENV        = production
#   MONGODB_URI     = your MongoDB Atlas connection string
#   JWT_SECRET      = a cryptographically random string
#   JWT_EXPIRES_IN  = 7d
#   CLIENT_URL      = https://your-app.vercel.app
#   COOKIE_SECRET   = a cryptographically random string
#   ADMIN_EMAIL     = admin@leaddesk.com
#   ADMIN_PASSWORD  = your strong admin password
